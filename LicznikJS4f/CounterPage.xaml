<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LicznikJS4f.CounterPage"
             Title="CounterPage">
    <VerticalStackLayout Spacing="15" Padding="20">
        <Label Text="Add a counter and choose its starting value."
               Style="{StaticResource Headline}"
               HorizontalOptions="Center" Margin="25"/>
        <Entry x:Name="NewCounterEntry"
               Placeholder="Enter counter name."/>
        <Entry x:Name="InitialValueEntry"
               Placeholder="Starting value (default: 0)"
               Keyboard="Numeric"/>
        <Button Text="Add Counter"
                Clicked="Button_add_Counter"/>
        <CollectionView x:Name="CountersCollection">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <HorizontalStackLayout>
                        <Label  
                            Text="{Binding Name}"
                            VerticalOptions="Center"
                            WidthRequest="120"/>
                        <Label
                            Text="{Binding Value}"
                            VerticalOptions="Center"
                            WidthRequest="50"/>
                        <Button Text="+"
                            Clicked="OnIcrementClicked" 
                            WidthRequest="40"/>
                        <Button Text="-" 
                            Clicked="OnDecrementClicked" 
                            WidthRequest="40"/>     
                    </HorizontalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
           
        </CollectionView>


    </VerticalStackLayout>
</ContentPage>
